# cs-lookup-files environment template
#
# Copy this file to `.env` and fill in the values you need. The pipeline reads
# `.env` at startup (through python-dotenv), so `$VAR` references in
# `config/sources.yaml` resolve exactly as if the variables were exported in the
# shell. Real environment variables take precedence over `.env` values.
#
# Sources that require a key are SKIPPED (not failed) until the key is set.
# Feed sources without secrets (FireHOL, Spamhaus, Abuse.ch, DShield) need
# nothing here.

# AbuseIPDB blacklist export. Get one at https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# AlienVault OTX (AlienVault Open Threat Exchange) export.
# Get one at https://otx.alienvault.com/settings/dashboard
OTX_API_KEY=

# Optional: concurrency used for source downloads (default 6).
# MAX_WORKERS=6